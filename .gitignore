
# =========================
# Symfony Backend
# =========================

/Backend/vendor/
/Backend/var/
/Backend/.env.local
/Backend/.env.*.local
/Backend/.env.local.php

# Symfony cache and logs
/Backend/var/cache/
/Backend/var/log/

# PHPUnit
/Backend/phpunit.xml
/Backend/.phpunit.result.cache

# Symfony secrets (keep encrypted vault keys out of Git)
# Review your secrets management strategy before committing keys.
# /Backend/config/secrets/*/*.decrypt.private.php

# Composer
/Backend/auth.json

# IDE
/Backend/.idea/
/Backend/.vscode/

# =========================
# React / Vite Frontend
# =========================

/Frontend/node_modules/
/Frontend/dist/
/Frontend/build/
/Frontend/.env
/Frontend/.env.local
/Frontend/.env.*.local

# Logs
/Frontend/npm-debug.log*
/Frontend/yarn-debug.log*
/Frontend/pnpm-debug.log*

# Testing
/Frontend/coverage/

# Cache
/Frontend/.vite/
/Frontend/.cache/

# IDE
/Frontend/.idea/
/Frontend/.vscode/

# =========================
# General
# =========================

.DS_Store
Thumbs.db
*.log
*.tmp
*.swp
*.swo
*.bak

# Cache and logs (Symfony2)
/app/cache/*
/app/logs/*
!app/cache/.gitkeep
!app/logs/.gitkeep

# Email spool folder
/app/spool/*

# Cache, session files and logs (Symfony3)
/var/cache/*
/var/logs/*
/var/sessions/*
!var/cache/.gitkeep
!var/logs/.gitkeep
!var/sessions/.gitkeep

# Logs (Symfony4)
/var/log/*
!var/log/.gitkeep

# Parameters
/app/config/parameters.yml
/app/config/parameters.ini

# Managed by Composer
/app/bootstrap.php.cache
/var/bootstrap.php.cache
/bin/*
!bin/console
!bin/symfony_requirements
/vendor/

# Assets and user uploads
/web/bundles/
/web/uploads/

# PHPUnit
/app/phpunit.xml
/phpunit.xml

# Build data
/build/

# Composer PHAR
/composer.phar

# Backup entities generated with doctrine:generate:entities command
**/Entity/*~

# Embedded web-server pid file
/.web-server-pid
